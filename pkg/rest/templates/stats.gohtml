<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">Connections</span>
            <span class="p-1.5 bg-blue-500/10 text-blue-400 rounded-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </span>
        </div>
        <p class="mt-2 text-2xl font-bold text-white">{{ .ConnectionCount }}</p>
        <p class="mt-1 text-xs text-slate-400">Active WebSocket Clients</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">Channels</span>
            <span class="p-1.5 bg-teal-500/10 text-teal-400 rounded-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                </svg>
            </span>
        </div>
        <p class="mt-2 text-2xl font-bold text-white">{{ .ChannelCount }}</p>
        <p class="mt-1 text-xs text-slate-400">Active broadcast groups</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">Worker Pool</span>
            <span class="p-1.5 bg-amber-500/10 text-amber-400 rounded-lg">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
            </span>
        </div>
        <p class="mt-2 text-2xl font-bold text-white">{{ .NumWorkers }}</p>
        <p class="mt-1 text-xs text-slate-400">Parallel sender goroutines</p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">System Status</span>
            <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
        </div>
        <p class="mt-2 text-2xl font-bold text-emerald-400">Online</p>
        <p class="mt-1 text-xs text-slate-400">Ready for messages</p>
    </div>
</div>
