    "paths": {
        "/channel/{channel}/clients": {
            "get": {
                "description": "returns list of all clients subscribed to a specific channel",
                "operationId": "get-channel-clients",
                "parameters": [
                    {
                        "description": "Channel name",
                        "in": "path",
                        "name": "channel",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "type": "string"
                                    },
                                    "type": "array"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/pkg_rest.HTTPResultMessage"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "summary": "list clients in channel",
                "tags": [
                    "wsbroker"
                ]
            }
        },
